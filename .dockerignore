# Everything is left out of the build context, but what the Dockerfile copies: the built
# workspaces, and what `npm ci` needs to install the dependencies of the backend.
*

!package.json
!package-lock.json
!docker-entrypoint.sh
!docker-health-check.ts

# `npm ci` checks the lockfile against every workspace, the frontend included
!echo_utilities/package.json
!echo_backend/package.json
!echo_frontend/package.json

!echo_utilities/dist
!echo_backend/dist
!echo_frontend/dist

# Vite copies them from public/ into dist/: the entrypoint writes its own at every start
echo_frontend/dist/env.*.json

**/.DS_Store
