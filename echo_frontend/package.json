{
  "name": "echo_frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode development",
    "build": "tsc -b && vite build --mode production",
    "types:check": "tsc -b",
    "format": "prettier --write . --ignore-path ../.gitignore --ignore-path ../.prettierignore",
    "lint": "eslint . --fix",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage --coverage.thresholds.100",
    "open:coverage": "http-server coverage -p 9003 -c-1",
    "arch:check": "depcruise src --config .dependency-cruiser.mts"
  },
  "dependencies": {
    "@echo/utilities": "file:../echo_utilities",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@mui/x-date-pickers": "^9.18.0",
    "@tanstack/react-query": "^5.107.1",
    "axios": "^1.21.1",
    "dayjs": "^1.11.23",
    "i18next": "^27.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.1",
    "react-router-dom": "^7.18.5",
    "use-debounce": "^10.1.1"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "dependency-cruiser": "^18.7.2",
    "eslint": "^10.15.0",
    "eslint-import-resolver-node": "^0.4.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "nock": "^15.0.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
