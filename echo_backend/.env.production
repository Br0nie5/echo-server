SERVER_NAME="Local Production"

HAS_AUTHENTICATION="true"

HTTP_PORT="4000"

LOGS_DIR_PATH="../test_logs"
SERVER_LOGS_DIR_PATH="../server_logs"

# Optional, set both to serve over HTTPS
TLS_CERT_PATH="../certs/testing.cc-cert.pem"
TLS_KEY_PATH="../certs/testing.cc-key.pem"

SAVE_SELF_REPORTS_TO_FILE="true"
SELF_REPORTS_RETENTION_DAYS="10"

HAS_DOCUMENTATION_ROUTE="false"

LOGS_NOTIFIER_TIMEZONE="UTC"
LOGS_NOTIFIER_SCHEDULE="*/30 * * * *"
LOGS_NOTIFIER_WATCHED_LOGS_LEVELS="ERROR,WARNING"
