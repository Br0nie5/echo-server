SERVER_NAME="Local Production"

SERVER_URL="https://localhost:4000"

HAS_AUTHENTICATION="true"

HTTP_PORT="4000"

LOGS_DIR_PATH="../test_logs"
SERVER_LOGS_DIR_PATH="../server_logs"

# Optional, set both (and switch SERVER_URL to https://) to serve over HTTPS
TLS_CERT_PATH="../certs/localhost-cert.pem"
TLS_KEY_PATH="../certs/localhost-key.pem"

SAVE_SELF_REPORTS_TO_FILE=true
