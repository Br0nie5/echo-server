{
  "name": "echo_backend",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "types:check": "tsc --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "start": "NODE_ENV=production node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "lint": "eslint . --fix",
    "format": "prettier --write . --ignore-path ../.gitignore --ignore-path ../.prettierignore",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage --coverage.thresholds.100",
    "open:coverage": "http-server coverage -p 9002 -c-1",
    "arch:check": "depcruise src --config .dependency-cruiser.mts"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "description": "",
  "type": "module",
  "dependencies": {
    "@echo/utilities": "file:../echo_utilities",
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/jwt": "^10.2.5",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.7",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.9",
    "fastify": "^5.12.7",
    "fastify-plugin": "^6.0.1",
    "luxon": "^3.7.2",
    "node-cron": "^4.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/luxon": "^3.7.6",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.4",
    "dependency-cruiser": "^18.7.0",
    "eslint": "^9.39.5",
    "eslint-plugin-n": "^18.5.0",
    "fastify-tsconfig": "^3.0.0",
    "globals": "^17.13.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.4"
  }
}
