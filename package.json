{
  "name": "echo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "echo_utilities",
    "echo_frontend",
    "echo_backend"
  ],
  "scripts": {
    "prebuild": "[ -n \"$CI\" ] || npm install",
    "build": "npm run build --workspaces && tsc",
    "types:check": "npm run types:check --workspaces && tsc",
    "prestart": "npm run build",
    "start": "npm run start --workspace=echo_backend",
    "start:docker": "bash scripts/start_docker.sh",
    "dns:enable": "bash scripts/local_dns.sh enable",
    "dns:disable": "bash scripts/local_dns.sh disable",
    "certs:generate": "bash scripts/generate_certificates.sh",
    "predev": "npm run build --workspace=echo_utilities",
    "dev": "concurrently --names \"utilities,backend,frontend\" \"npm run dev --workspace=echo_utilities\" \"npm run dev --workspace=echo_backend\" \"npm run dev --workspace=echo_frontend\"",
    "deploy:server": "bash scripts/deploy_server.sh",
    "format": "npm run format --workspaces && prettier --write \"*.{ts,js,json,md}\" \"docs/**/*.md\" \"examples/**/*.{md,yaml}\" \".github/**/*.{md,yml,yaml}\" \".vscode/*.json\"",
    "lint": "npm run lint --workspaces && eslint . --fix",
    "test:coverage": "npm run test:coverage --workspaces",
    "open:coverage": "concurrently --names \"utilities,backend,frontend\" \"npm run open:coverage --workspace=echo_utilities\" \"npm run open:coverage --workspace=echo_backend\" \"npm run open:coverage --workspace=echo_frontend\"",
    "arch:check": "npm run arch:check --workspaces",
    "vulnerabilities:scan": "npm audit",
    "dead-code:check": "knip"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.19.2",
    "concurrently": "^10.0.6",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^65.4.2",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-tsdoc": "^0.5.4",
    "globals": "^17.13.0",
    "http-server": "^14.1.1",
    "knip": "^6.43.0",
    "lefthook": "^2.2.2",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true,
    "lefthook@2.2.2": true,
    "fsevents@2.3.3": true,
    "better-sqlite3@13.0.3": true
  }
}
