{
  "name": "echo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "echo_utilities",
    "echo_frontend",
    "echo_backend"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "start": "npm run build && npm run start --workspace=echo_backend",
    "start:docker": "bash scripts/start_docker.sh",
    "dev": "concurrently --names \"backend,frontend\" \"npm run dev --workspace=echo_backend\" \"npm run dev --workspace=echo_frontend\"",
    "format": "npm run format --workspaces",
    "lint": "npm run lint --workspaces",
    "test:coverage": "npm run test:coverage --workspaces",
    "open:coverage": "npm run open:coverage --workspaces",
    "generate:types": "bash scripts/generate_types.sh",
    "arch:check": "npm run arch:check --workspaces",
    "vulnerabilities:scan": "npm audit",
    "deploy:server": "bash scripts/deploy_server.sh"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "concurrently": "^10.0.5",
    "orval": "^8.40.0"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true,
    "better-sqlite3@13.0.3": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  },
  "//": "overrides: concurrently 10.0.5 pins shell-quote to 1.9.0, which has a critical command injection (GHSA-pqg4-j6r4-53mv, fixed in 1.11.0). Remove the override once concurrently depends on a patched shell-quote.",
  "overrides": {
    "shell-quote": "^1.12.0"
  }
}
